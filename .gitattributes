# Normalise line endings in the repository and check out LF everywhere.
#
# Without this, a Windows clone inherits core.autocrlf=true from the global
# config, rewrites every text file to CRLF on checkout, and `pnpm format:check`
# then fails on files nobody edited - Prettier's default is `endOfLine: "lf"`.
# The gate passes on CI and fails locally, which is the worst combination:
# it teaches contributors that the gate is unreliable.
#
# LF on checkout also keeps `scripts/gate.sh` and `run.sh` parseable by bash.
# A CRLF shebang makes the kernel look for an interpreter named `bash\r`.
* text=auto eol=lf

*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.xml text eol=lf

# Screenshots and the favicon are bytes, not text.
*.png binary
*.ico binary