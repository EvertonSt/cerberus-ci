# Names only. This file is a contract, not a secrets file: it tells a new
# contributor (and CI) exactly which variables the application reads.
# No value ever belongs in this file.

# --- engine -----------------------------------------------------------------
# Provider used to classify failures. One of: anthropic | openai-compatible | mock
AI_PROVIDER=mock
# Required when AI_PROVIDER is `anthropic`.
ANTHROPIC_API_KEY=
# Required when AI_PROVIDER is `openai-compatible`.
OPENAI_API_KEY=
# Base URL for an OpenAI-compatible endpoint (Ollama, vLLM, OpenRouter...).
OPENAI_BASE_URL=

# --- application ------------------------------------------------------------
# Shared secret required by POST /api/analyze. Never optional.
API_KEY=
# Absolute URL of the deployment, used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:4310

# --- runtime ----------------------------------------------------------------
NODE_ENV=development
