{
  "name": "cerberus-ci",
  "version": "2.0.0",
  "description": "Turns CI test results into a ranked, explained decision about what to fix first.",
  "private": false,
  "license": "MIT",
  "author": "EvertonSt",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "capture:screenshots": "tsx scripts/capture-screenshots.ts",
    "cerberus": "tsx src/cli/index.ts",
    "gate": "bash scripts/gate.sh",
    "verify": "pnpm verify:secrets && pnpm verify:links && pnpm verify:attribution",
    "verify:secrets": "tsx scripts/check-secrets.ts",
    "verify:links": "tsx scripts/check-links.ts",
    "verify:attribution": "tsx scripts/check-attribution.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.39.0",
    "clsx": "2.1.1",
    "commander": "13.1.0",
    "framer-motion": "13.1.1",
    "js-yaml": "4.3.2",
    "lucide-react": "1.33.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sql.js": "1.14.2",
    "tailwind-merge": "3.6.0",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^26",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sql.js": "1.4.11",
    "@types/xml2js": "0.4.14",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
